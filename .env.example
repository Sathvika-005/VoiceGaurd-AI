# ==============================================================================
# VoiceGuard AI - Environment Configuration
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# ==============================================================================

# --- Core AI Engines (Required for audio analysis) ----------------------------
# DetectifAI Aletheia API key (https://platform.detectif.ai)
DETECTIF_API_KEY=

# Google Gemini API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# Fast audio-capable Gemini model (verified 2026-11-24; quota fallback: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# --- Meta WhatsApp Cloud API (Optional: required only for WhatsApp bot) -------
# Temporary tokens expire every ~24h; use a System User token for longer demos
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret for X-Hub-Signature-256 webhook verification (strongly recommended)
WHATSAPP_APP_SECRET=

# Graph API version (verified 2026-11-24)
META_GRAPH_API_VERSION=v25.0

# Optional comma-separated E.164 phone numbers allowed on WhatsApp (empty = allow all)
WHATSAPP_ALLOWED_NUMBERS=

# --- Engine Endpoints & Audio Limits ------------------------------------------
ALETHEIA_API_URL=https://platform.detectif.ai/v1/deepfake/detect
MAX_UPLOAD_MB=16
MIN_AUDIO_SECONDS=4
MAX_ALETHEIA_SECONDS=120
MAX_TOTAL_AUDIO_MINUTES=10
ENABLE_SEGMENTATION=true

# --- Regional & Localization Defaults -----------------------------------------
REGION=IN
DEFAULT_REPORT_LANGUAGE=en

# --- Rate Limiting, Concurrency, Caching & Logging ----------------------------
RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_ANALYSES=3
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
DEBUG_RAW_RESPONSES=false

# Optional salt for hashing phone numbers in logs (defaults to random per-boot salt)
APP_SECRET_KEY=
